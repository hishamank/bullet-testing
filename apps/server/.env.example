# Copy to apps/server/.env (git-ignored). `pnpm --filter server start` loads it.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/bullet.db
AUDIO_DIR=./data/audio

# llama.cpp llama-server (OpenAI-compatible). LLM_MODEL is sent as `model`; llama-server serves
# whatever it loaded, so it is a label.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=qwen3.5-4b-q4_k_m
# LLM_API_KEY=
LLM_TIMEOUT_MS=180000

# whisper.cpp whisper-server. Leave unset to process voice notes on their device draft.
WHISPER_BASE_URL=http://127.0.0.1:8081
WHISPER_MODEL=large-v3-turbo-q5_0
# WHISPER_PROMPT=
TRANSCRIBE_TIMEOUT_MS=600000
