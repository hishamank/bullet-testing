    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@bullet/agent": "workspace:*",
    "@bullet/core": "workspace:*",
    "@bullet/db": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.26",
    "zod": "^3.25.76"
  }
}
